{
  "openapi": "3.0.1",
  "info": {
    "title": "AudioToText | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5298/"
    }
  ],
  "paths": {
    "/api/Audio": {
      "post": {
        "tags": [
          "Audio"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "form": {
                    "type": "array",
                    "items": {
                      "required": [
                        "key",
                        "value"
                      ],
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "nullable": true
                        },
                        "value": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/RecognitionResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecognitionResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecognitionResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RecognitionResult": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Audio"
    }
  ]
